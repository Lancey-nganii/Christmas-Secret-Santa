{
  "appId": "com.macorol.christmaswishlist",
  "appName": "Christmas Wishlist",
  "webDir": "dist",
  "backgroundColor": "#FFF8F0",
  "server": {
    "androidScheme": "https"
  },
  "android": {
    "backgroundColor": "#FFF8F0"
